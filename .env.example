# ==========================================
# Cookie Tracker Graph — Environment Variables
# ==========================================

# Port mappings for host access
FRONTEND_PORT=3050
BACKEND_PORT=8000

# Next.js Public Client API Endpoint (Client-accessible URL)
# MUST reference localhost or public domain name when queried from browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js Server-Side API Endpoint (Internal Docker service name)
# Can reference the Docker service name directly inside the bridge network.
INTERNAL_API_URL=http://cookie-backend:8000

# FastAPI environment settings
FASTAPI_ENV=development

# Third-party integrations (placeholders)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
GDELT_API_KEY=your_gdelt_api_key_here
